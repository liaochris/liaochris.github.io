<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless{% if include.limit and page.announcements.limit and news_size > page.announcements.limit %} mb-0{% endif %}">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news %}
          <tr {% if forloop.index > news_limit %}class="news-extra d-none"{% endif %}>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_size > news_limit %}
      <a href="#" role="button" id="news-toggle" style="display: inline-block; padding-left: 0.3rem; margin-bottom: 2rem">Show more</a>
      <script>
        document.getElementById('news-toggle').addEventListener('click', function (e) {
          e.preventDefault();
          var expanded = this.textContent === 'Show less';
          document.querySelectorAll('.news-extra').forEach(function (row) {
            row.classList.toggle('d-none', expanded);
          });
          this.textContent = expanded ? 'Show more' : 'Show less';
        });
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

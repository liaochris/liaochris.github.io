@article{LiaoScience2026,
  bibtex_show={true},
  title={Science at the Frontier: How Scientists Use ChatGPT},
  author={Liao, Christopher and Shan, Carl and Chatterji, Aaron},
  abstract={We study how academic scientists use AI, analyzing over half a million scientific messages from 1,819 scientists enrolled in the ChatGPT for Academic Researchers plan. We document four key findings. First, AI use is concentrated in a few scientific activities: just two—reading and writing—account for over half of the average scientist's scientific messages. Second, AI plays a role in shaping which ideas scientists consider and how they develop them into research questions. When exploring research directions, scientists often ask AI to propose what to investigate; when developing specific research questions, scientists typically supply the question or idea and ask AI to refine or evaluate it. Third, scientists remain involved in research execution, following up on AI output after about one-third of requests, on average. Within the same scientific task, scientists follow-up more often for requests requiring greater scientific expertise. Finally, 98\% of survey respondents expect AI to increase the rate of scientific discovery in their field, most often citing faster completion of research tasks.},
  category={Working Papers},
  year={2026},
  month={November},
  pdf={Science.pdf},
  summary={ScienceSummary.pdf},
  press={[OpenAI](https://openai.com/index/science-at-the-frontier/)},
  url={liaochris.github.io/assets/pdf/Science.pdf},
  selected={true},
}
@article{LiaoResilience2025,
  bibtex_show={true},
  title={Organizational Resilience: Evidence from Open Source Software},
  author={Liao, Christopher},
  abstract={I conduct a large-scale empirical study of open source software organizations to examine which organizational practices affect organizational resilience. Measuring resilience by the impact of a key member's exit on software development and release activity, I find that on average, organizational outcomes drop permanently by up to 0.8 standard deviations post-departure. I then develop a novel method combining flexible machine learning models with event studies that separates organizations into groups that differ markedly in measured resilience. Leveraging interpretable machine learning methods, I show that practices highlighted in the existing literature do not enhance resilience on their own, but do enhance resilience through complementarities with other practices.},
  category={Working Papers},
  year={2025},
  month={December},
  pdf={OrgResilience.pdf},
  url={liaochris.github.io/assets/pdf/OrgResilience.pdf},
  selected={true},
}
@article{LiaoForest2025,
  bibtex_show={true},
  title={Generalized Random Forest Event Studies},
  author={Liao, Christopher},
  abstract={This note introduces a procedure for estimating heterogeneous dynamic treatment effects in event studies with staggered adoption, allowing heterogeneity to vary by treatment adoption date and with observation-level time-invariant covariates. The approach reformulates the problem as estimating a conditional linear model with binary regressors and estimates all cohort–event time conditional treatment effects jointly using a single generalized random forest, with propensity scores adapted to staggered treatment adoption in panel settings. },
  category={Working Papers},
  year={2025},
  month={December},
  pdf={ForestEventStudy.pdf},
  url={liaochris.github.io/assets/pdf/ForestEventStudy.pdf},
  selected={true},
}
